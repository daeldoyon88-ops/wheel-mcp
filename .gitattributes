# Governance is content-addressed: the ledger, seals, snapshots and the active
# pointer all pin sha256 digests of these exact bytes. Git's end-of-line
# conversion (core.autocrlf is enabled system-wide on Windows) rewrites those
# bytes on checkout, so a normal clone would break every pin at once and the
# preflight would report LEDGER_INVALID before any work could start. Same
# reason, same mechanism as the content-addressed fixtures above.
governance/** -text
AGENTS.md text eol=lf
CLAUDE.md text eol=lf
.cursor/rules/00-wheel-critical-policy.mdc text eol=lf

# GATE25 historical regime foundation: macro evidence and CAS objects are pinned by the
# sha256 of their exact bytes (the ALFRED archive carries raw CR bytes). Preserve bytes,
# never convert. Same mechanism as the content-addressed trees above.
data/jarvise/historical-macro-context/** -text

# GATE25 analogue index publication transport: GitHub rejects normal Git blobs
# above 100 MB. Preserve analogue working-tree bytes against core.autocrlf, and
# track ONLY ANALOGUE_INDEX.json through Git LFS. Canonical JSON bytes and the
# PROVENANCE analogueIndexSha256 binding are unchanged.
data/jarvise/historical-analogue/** -text
data/jarvise/historical-analogue/GATE25/V1/ANALOGUE_INDEX.json filter=lfs diff=lfs merge=lfs -text

      "gitOperationPolicy": {
        "subject": "GOVERNED_AGENT_EXECUTION",
        "agentAutomaticPush": "FORBIDDEN_ALWAYS",
        "agentAutomaticCommitWithoutOwnerApproval": "FORBIDDEN",
        "ownerApprovedTargetedLocalCommit": "ALLOWED_BY_OWNER_EXPLICIT_APPROVAL",
        "ownerApprovedCommitRequiresCryptographicAuthorization": false,
        "ownerManualShellPush": "OUT_OF_SCOPE_OF_AGENT_EXECUTION_AUTHORITY",
        "ownerManualShellPushRequiresCryptographicAuthorization": false,
        "cryptographicReleaseAuthorization": "OPTIONAL_HIGH_SECURITY_MODE",
        "commitPathspecPolicy": "EXPLICIT_PATHSPECS_ONLY",
        "maxCommitsPerOwnerApproval": 1,
        "humanShellDetection": "NOT_A_MECHANISM_THIS_IS_A_GOVERNANCE_BOUNDARY",
        "notes": "L’agent ne peut jamais déduire une permission de push d’une permission de commit. L’approbation du propriétaire est une frontière de gouvernance constatée dans la mission, pas un artefact cryptographique à produire."

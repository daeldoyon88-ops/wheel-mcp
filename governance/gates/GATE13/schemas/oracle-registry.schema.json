{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","gateId","registryRevision","policyId","oracles"],
  "properties":{
    "schemaVersion":{"const":1},
    "gateId":{"const":"GATE13"},
    "registryRevision":{"type":"string","pattern":"^R[0-9]{4}$"},
    "policyId":{"type":"string"},
    "oracles":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/oracle"}}
  },
  "$defs":{
    "oracle":{
      "type":"object","additionalProperties":false,
      "required":["oracleId","path","authorityClass","sourceType","required","expectedSha256","freshnessPolicy","failurePolicy","fallbackPolicy","provenance","consumerIds"],
      "properties":{
        "oracleId":{"type":"string","pattern":"^G13-O-[0-9]{3}$"},
        "path":{"type":"string","pattern":"^[^\\\\/*?]+(?:/[^\\\\/*?]+)*$"},
        "authorityClass":{"type":"string"},"sourceType":{"enum":["JSON","NDJSON","MARKDOWN"]},
        "required":{"type":"boolean"},"expectedSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "freshnessPolicy":{"type":"string"},"failurePolicy":{"type":"string"},"fallbackPolicy":{"type":"string"},
        "provenance":{"type":"string","minLength":1},"consumerIds":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}

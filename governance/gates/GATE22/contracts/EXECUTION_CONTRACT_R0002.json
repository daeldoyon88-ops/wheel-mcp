  "canonicalRequirements": [
    {
      "requirementId": "G22-BUILD-01",
      "statement": "Materialize exactly the seven frozen domain contracts C1..C7 at their planned contract paths, each machine-bound to its mandate projection digest; no eighth contract, no rename, no merge, no version change.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/domainContracts"
    },
    {
      "requirementId": "G22-BUILD-02",
      "statement": "Implement the BOTTOM/TOP LABEL ENGINE strictly as the Observation(T) to Outcome(T+H) transform; produce no prediction, recommendation, Wheel decision, market regime or strategy.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/missionBoundary"
    },
    {
      "requirementId": "G22-BUILD-03",
      "statement": "Horizon H is a session count in {30, 90, 180, 252}; calendar horizons are forbidden; REGULAR_SESSION equals HALF_DAY_SESSION equals one session; HorizonId is sessionCount plus calendarRegistryManifestId.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/immutableInvariants"
    },
    {
      "requirementId": "G22-BUILD-04",
      "statement": "The OutcomeId tuple is closed at exactly six ordered components and the ObservationId tuple at exactly eight, both EXACT_ONLY, carrying InstrumentIdentityId and excluding ticker, symbol, temporary alias, status and reason.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/immutableInvariants"
    },
    {
      "requirementId": "G22-BUILD-05",
      "statement": "PriceBasis V1 is exactly three members; DERIVED_ADJUSTED is refused; the basis is identical from T to T+H and any mixture is FAIL_CLOSED; no unsupported or derived basis may be relabeled.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/immutableInvariants"
    },
    {
      "requirementId": "G22-BUILD-06",
      "statement": "The Observation Dataset and the Outcome Dataset stay separate; the Outcome Dataset asOf is a deterministic function of the bytes; a restatement produces a new DatasetId; no cross-version stitching and no build-time snapshot selection.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/immutableInvariants"
    },
    {
      "requirementId": "G22-BUILD-07",
      "statement": "Outcome persistence is append-only with OutcomeStatus of exactly three values; before the Outcome Dataset asOf no Outcome record and no OutcomeId exist; absence is never converted into a status and no settlement bound is emitted for absent data.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/immutableInvariants"
    },
    {
      "requirementId": "G22-BUILD-08",
      "statement": "Taxonomy V1 is exactly six mechanical, non-exclusive, versioned primitives; no addition and no renaming; the registryConcept to taxonomyPrimitive projection stays a compatibility projection.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/domainContracts/contracts/5"
    },
    {
      "requirementId": "G22-BUILD-09",
      "statement": "GATE23 consumes GATE21 and Observation only and never consumes Outcome, not even lagged; GATE24 lives in a separate namespace; GATE25 attaches Outcome only after selection.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/domainContracts/contracts/6"
    },
    {
      "requirementId": "G22-BUILD-10",
      "statement": "consumesGate21Pins stays a subset of the frozen GATE21 LAB_SCHEMA_PINS; GATE22-owned pins are consumed only through consumesGate22SuccessorPins; no secondary pin authority and no parallel pin field.",
      "normativeSource": "governance/sources/GATE22_CANONICAL_MANDATE_R0.json#/gate21PinVocabulary"
    },
    {
      "requirementId": "G22-BUILD-11",
      "statement": "Preserve EXECUTION_CONTRACT_R0001 bytes and the GATE22 START binding; this revision activates materialization and functional BUILD scope only and does not close, confirm, replay START, or authorize GATE23.",
      "normativeSource": "governance/gates/GATE22/contracts/EXECUTION_CONTRACT_R0001.json"
    },
    {
      "requirementId": "G22-BUILD-12",
      "statement": "GATE21 surfaces and research/directional-lab stay byte-identical; no GATE21 R0006 is created and no GATE21 state is reopened.",
      "normativeSource": "governance/gates/GATE21/state/CURRENT_STATE.json"
    }
  ],

    "contractKey": "C3",
    "contractId": "GATE22_IDENTITY_MODEL_V1",
    "version": 1,
    "designFreezeRef": "OBSERVATION_OUTCOME_IDENTITY_V1",
    "purpose": "Content-addressed identity model. InstrumentIdentityId is the single canonical source of instrument identity; ticker != identity; FormulaId is behavior and a behavioral change produces a new identity. C3 owns the composition rule, not the source vocabularies.",
    "consumesGate21Pins": [
      "marketDataSourceL3",
      "DatasetSnapshotCore",
      "DatasetSnapshotRecord",
      "DatasetManifestV1",
      "marketCalendarRegistry"
    ],
    "consumesGate22SuccessorPins": [
      "instrumentIdentityV1"
    ],
    "identityDigestRules": {
      "instrumentIdentityIdRequired": true,
      "observationIdComposition": {
        "closure": "EXACT_ONLY",
        "count": 8,
        "ordered": [
          "InstrumentIdentityId",
          "SessionDate",
          "KnowledgeCutoff",
          "AvailableAt",
          "Source",
          "DatasetId_observation",
          "PriceBasisId",
          "MissingnessState"
        ]
      },
      "outcomeIdComposition": {
        "closure": "EXACT_ONLY",
        "count": 6,
        "ordered": [
          "ObservationId",
          "HorizonId",
          "FormulaId",
          "DatasetId_outcome",
          "PriceBasisId",
          "TaxonomyVersion"
        ]
      },
      "closureRule": "EXACT_ONLY: no optional field, no interpretable field, no implicit extension, no at-minimum reading",
      "forbiddenInAnyIdentityDigest": [
        "ticker",
        "symbol",
        "temporary alias",
        "every field of ALIAS_BINDING_FIELDS",
        "OutcomeStatus",
        "OutcomeMissingReason",
        "OutcomeWindowCause"
      ],
      "readingPrinciple": "the OutcomeId identifies the question asked, never the answer; status and reason are therefore excluded, which is the generalization of B-2",
      "horizonIdNotInObservationId": "an Observation is horizon-free and serves several H, consistent with C1",
      "instrumentIdentityV1NotModified": true,
      "formulaIdRule": "FormulaId is behavior; a behavioral change produces a new identity",
      "shareClassRepresentation": "distinct share classes are distinct identities carrying distinct identitySeed values and their own aliases; there is no shareClass field in the lab and none is assumed"
    }
  },
  "consumesGate21Pins": [

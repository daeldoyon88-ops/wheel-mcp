    "contractId": "GATE22_OUTCOME_PERSISTENCE_V1",
    "version": 1,
    "designFreezeRef": "TARGET_BOUNDARY_CONTRACT_V1",
    "purpose": "Outcome persistence and missingness routing. Before the Outcome Dataset asOf is reached no Outcome record and no OutcomeId exist. After it, the record carries RESOLVED, INSUFFICIENT_DATA or FAIL_CLOSED. Append-only, no historical mutation. Hosts the internal OutcomeMissingReason structure ratified by B-2.",
    "consumesGate21Pins": [
      "MissingReasonsV1",
      "coverage",
      "DatasetSnapshotRecord",
      "SnapshotDatasetManifestV1"
    ],
    "consumesGate22SuccessorPins": [],
    "outcomeStatus": {
      "values": [
        "RESOLVED",
        "INSUFFICIENT_DATA",
        "FAIL_CLOSED"
      ],
      "count": 3,
      "notYetResolvedIsNotAnEnumValue": true,
      "notYetResolvedRepresentation": "absence of an Outcome record, never a stored value",
      "appendOnly": true,
      "historicalMutation": "FORBIDDEN_ALWAYS"
    },
    "outcomeMissingReason": {
      "classification": "INTERNAL_STRUCTURE_OF_C2",
      "isNewContract": false,
      "isNewStatus": false,
      "isNewPrimitive": false,
      "reasonClass": [
        "INPUT",
        "WINDOW",
        "BASIS"
      ],
      "inputCause": "value of MissingReasonsV1 (GATE21 pin) or null",
      "windowCause": "value of OutcomeWindowCause/1 (local to C2) or null",
      "exactlyOneOfInputCauseOrWindowCauseIsNonNull": true,
      "reasonParticipatesInOutcomeId": false,
      "resolvedIffReasonIsNull": "OutcomeStatus === RESOLVED if and only if OutcomeMissingReason === null"
    },
    "outcomeWindowCauseV1": {
      "surfaceVersionedWith": "GATE22_OUTCOME_PERSISTENCE_V1",
      "count": 4,
      "values": [
        {
          "cause": "INSUFFICIENT_SESSIONS_IN_WINDOW",
          "routesTo": "INSUFFICIENT_DATA",
          "decidability": "calendar fact, decidable at T against the pinned calendar registry"
        },
        {
          "cause": "CALENDAR_GAP_IN_WINDOW",
          "routesTo": "INSUFFICIENT_DATA",
          "decidability": "calendar fact, decidable at T against the pinned calendar registry"
        },
        {
          "cause": "PRICE_BASIS_MIXED_IN_WINDOW",
          "routesTo": "FAIL_CLOSED",
          "decidability": "settled bars, observed mixture at the asOf"
        },
        {
          "cause": "PRICE_BASIS_UNAVAILABLE_FOR_WINDOW",
          "routesTo": "FAIL_CLOSED",
          "decidability": "settled bars, basis absent at the asOf"
        }
      ],
      "retired": [
        {
          "cause": "OUTCOME_WINDOW_TRUNCATED_BY_DATASET_END",
          "retiredBy": "O-3",
          "reason": "its instantiation would require knowing the future non-arrival of data, which is a latent NO_FUTURE_LEAKAGE violation and, under the C-2 asOf rule, dead vocabulary"
        }
      ]
    },
    "nonEmissionRule": {
      "rule": "No Outcome record and no OutcomeId exist while the C5 asOf is not reached, whether the absence is temporary or permanent.",
      "absenceNeverConvertedToStatus": true,
      "settlementBoundExists": false,
      "note": "the system never has to decide whether the data will arrive one day; temporary and permanent absence receive the same treatment, which is why no settlement bound is required and no new rule enters the mandate"
    }
  },

  "knowledgeCutoffPolicy": {
    "formula": "K(T) = PinnedCanonicalSession(T).closeUtc",
    "sessionPredicate": "sessionDate == T and sessionKind in allowedSessionKinds",
    "uniqueness": "exactly one canonical session record; zero is PINNED_CANONICAL_SESSION_ABSENT and more than one is PINNED_CANONICAL_SESSION_NOT_UNIQUE",
    "regularSession": "uses its own canonical closeUtc",
    "halfDaySession": "uses its own canonical closeUtc",
    "forbiddenPrimitive": "marketSession.mjs::sessionCloseUtc",
    "forbiddenPrimitiveCode": "FORBIDDEN_CUTOFF_PRIMITIVE",
    "forbiddenWallClockConstants": ["16:00", "09:30", "20:00", "21:00"],
    "forbiddenWallClockCode": "WALL_CLOCK_CUTOFF_CONSTANT_FORBIDDEN",
    "prohibitionReading": "the prohibition is on the derivation, not on the value; a canonical session may legitimately close at 21:00Z, but K(T) may never be derived from a wall-clock convention or from the forbidden primitive",
    "admissibleCutoffDerivation": "PINNED_CANONICAL_SESSION_CLOSE_UTC",
    "disclosure": "K(T), the sessionKind and the CalendarWindowBindingId are disclosed on every materialization result",
    "optionB": "INITIAL_ROOT settlingAt(T)",
    "optionBStatus": "NOT_EXECUTABLE_WITH_CURRENT_PRIMITIVES",
    "optionBDisposition": "FUTURE_ADDITIVE_OPTION"
  },
  "priceBasisPolicy": {
    "admissible": "SPLIT_ADJUSTED",
    "admissibleClosure": "SPLIT_ADJUSTED_ONLY",
    "forbidden": ["TOTAL_RETURN_ADJUSTED", "DERIVED_ADJUSTED"],
    "forbiddenCode": "PRICE_BASIS_TOTAL_RETURN_FORBIDDEN",
    "nonAdmittedCode": "PRICE_BASIS_NOT_ADMITTED_V1",
    "mixedBasisCode": "PRICE_BASIS_MIXED_IN_WINDOW",
    "implicitDividendTotalReturn": "FORBIDDEN",
    "implicitDividendCode": "IMPLICIT_DIVIDEND_TOTAL_RETURN_FORBIDDEN",
    "splitRatios": "any strictly positive finite ratio, including 2:1, 11:10, 3:2 and reverse 1:10; no integer assumption and no >= 1 assumption",
    "invalidRatioCode": "SPLIT_RATIO_INVALID",
    "pointInTimeRule": "a later corporate-action restatement never rewrites a historical FeatureRecord",
    "pointInTimeMechanism": "a restatement under the same DatasetId_observation keeps the FeatureRecordId and is refused by the store as FEATURE_STORE_RESTATEMENT_CONFLICT; a restatement published under a new DatasetId_observation is a new FeatureRecordId and leaves history intact",

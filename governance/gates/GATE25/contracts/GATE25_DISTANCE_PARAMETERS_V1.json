    "distance": "MANHATTAN_L1",
    "distanceFeatureIds": [
      "F1_SIMPLE_RETURN@W5",
      "F1_SIMPLE_RETURN@W21"
    ],
    "distanceFeatureSource": "OD-2 authorized dimensions exactly",
    "weights": "NONE; each dimension weight is implicitly 1; configurable weights forbidden",
    "normalization": {
      "method": "PER_DIMENSION_MIN_MAX",
      "population": "frozen eligible HISTORICAL candidate universe for query T",
      "queryObservationInPopulation": false,
      "formula": "normalized = (x - min) / (max - min)"

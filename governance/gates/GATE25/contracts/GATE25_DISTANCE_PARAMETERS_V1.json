    "zeroRange": {
      "condition": "max == min",
      "queryNormalizedValue": 0,
      "candidateNormalizedValue": 0,
      "componentDistance": 0,
      "dimensionRetained": true,
      "dimensionDropped": false
    },
    "componentDistance": "absoluteNormalizedDelta = |queryNormalizedValue - candidateNormalizedValue|",

    "numericRules": {
      "finiteNumbersOnly": true,
      "epsilon": "NONE",
      "tolerance": "NONE",
      "intermediateRounding": "FORBIDDEN",
      "configurableWeights": "FORBIDDEN"
    },
    "representation": "CanonicalJSON/1 provides the deterministic representation"

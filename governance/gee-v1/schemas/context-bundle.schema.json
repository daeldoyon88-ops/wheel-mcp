{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gee-v1/context-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleKind", "authorityDeclaration", "identity", "activeState", "objective", "applicableConstraints", "relevantSources", "activeDefectsOrBlockers", "reusableEvidenceReferences", "prohibitedActions", "successConditions", "nextAction", "facts"],
  "properties": {
    "schemaVersion": { "const": 1 }, "bundleKind": { "const": "GEE_CONTEXT_BUNDLE" }, "authorityDeclaration": { "const": "DERIVED / NON_AUTHORITATIVE" },
    "identity": { "type": "object", "required": ["project", "workUnitType", "workUnitId", "mission", "compilerVersion", "sourceHead"], "additionalProperties": false, "properties": { "project": { "type": "string" }, "workUnitType": { "type": "string" }, "workUnitId": { "type": "string" }, "mission": { "type": "string" }, "compilerVersion": { "type": "string" }, "sourceHead": { "type": "string" } } },
    "activeState": { "type": "object", "required": ["canonicalStatus", "prerequisites", "blockers", "provenance"], "properties": { "canonicalStatus": { "type": "string" }, "prerequisites": { "type": "array", "items": { "type": "object", "required": ["provenance"], "properties": { "provenance": { "$ref": "#/definitions/provenance" } } } }, "blockers": { "type": "array", "items": { "type": "object", "required": ["code", "detail", "provenance"], "properties": { "code": { "type": "string" }, "detail": { "type": "string" }, "provenance": { "$ref": "#/definitions/provenance" } } } }, "provenance": { "$ref": "#/definitions/provenance" } } },
    "objective": { "type": "object", "required": ["missionObjective", "expectedOutcome", "provenance"], "properties": { "missionObjective": { "type": "string" }, "expectedOutcome": { "type": "string" }, "provenance": { "$ref": "#/definitions/provenance" } } },
    "applicableConstraints": { "type": "array", "items": { "type": "object", "required": ["ruleId", "statement", "provenance"], "properties": { "ruleId": { "type": "string" }, "statement": { "type": "string" }, "provenance": { "$ref": "#/definitions/provenance" } } } },
    "relevantSources": { "type": "array", "items": { "type": "object", "required": ["path", "role", "relevanceReason", "sha256", "authorityClass"], "properties": { "path": { "type": "string" }, "role": { "type": "string" }, "relevanceReason": { "type": "string" }, "sha256": { "type": "string" }, "authorityClass": { "enum": ["CANONICAL", "CANONICAL_STATUS", "CANONICAL_OBJECTIVE", "CANONICAL_RULE", "CANONICAL_EVIDENCE", "EXECUTION_CONTRACT", "NON_AUTHORITATIVE"] } } } },
    "activeDefectsOrBlockers": { "type": "array" }, "reusableEvidenceReferences": { "type": "array", "items": { "type": "object", "required": ["ref", "reason", "authorityStatus"], "properties": { "ref": { "type": "string" }, "reason": { "type": "string" }, "authorityStatus": { "enum": ["GROUNDED", "NON_AUTHORITATIVE_UNVERIFIED"] }, "provenance": { "anyOf": [{ "$ref": "#/definitions/provenance" }, { "type": "null" }] } } } }, "prohibitedActions": { "type": "array", "items": { "type": "string" } }, "successConditions": { "type": "array", "items": { "type": "string" } }, "nextAction": { "type": "string" }, "facts": { "type": "array", "items": { "type": "object", "required": ["id", "value", "provenance"], "properties": { "id": { "type": "string" }, "value": {}, "provenance": { "$ref": "#/definitions/provenance" } } } }
  },
  "definitions": { "provenance": { "type": "object", "required": ["sourcePath", "authorityClass", "selectionReason"], "properties": { "sourcePath": { "type": "string" }, "sourceField": { "type": "string" }, "sourceSha256": { "type": "string" }, "authorityClass": { "enum": ["CANONICAL", "CANONICAL_STATUS", "CANONICAL_OBJECTIVE", "CANONICAL_RULE", "CANONICAL_EVIDENCE", "EXECUTION_CONTRACT", "NON_AUTHORITATIVE"] }, "selectionReason": { "type": "string" } } } }
}

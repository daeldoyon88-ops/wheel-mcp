{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "schemaVersion",
    "authorityId",
    "authorityClass",
    "issuedBy",
    "issuedAtUtc",
    "targetSystem",
    "frozenRevision",
    "workUnitId",
    "reason",
    "defects",
    "authorizedPaths",
    "newGeeRevisionAuthorized",
    "r8Authorized",
    "gateExecutionAuthorized",
    "successorAuthorization",
    "unrelatedWritesAuthorized"
  ],
  "properties": {
    "document": { "const": "GEE_V1_POST_FREEZE_MAINTENANCE_AUTHORITY" },
    "schemaVersion": { "const": 1 },
    "authorityId": { "type": "string", "pattern": "^GEE_V1_POST_FREEZE_MAINTENANCE_AUTHORITY_[A-Za-z0-9_-]+$" },
    "authorityClass": { "const": "PROJECT_OWNER_POST_FREEZE_MAINTENANCE_AUTHORITY" },
    "issuedBy": { "const": "PROJECT_OWNER" },
    "issuedAtUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$" },
    "targetSystem": { "const": "GEE_V1" },
    "frozenRevision": { "const": "R7" },
    "workUnitId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "reason": { "type": "string", "minLength": 1 },
    "defects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authorizedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*:)(?!.*\\\\)(?![\\/])(?!.*[*?])(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$))[^\\u0000]+$"
      }
    },
    "newGeeRevisionAuthorized": { "const": false },
    "r8Authorized": { "const": false },
    "gateExecutionAuthorized": { "const": false },
    "successorAuthorization": { "const": false },
    "unrelatedWritesAuthorized": { "const": false }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gee-v1/readiness-result.schema.json",
  "title": "GEE V1 work-unit readiness result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workUnitId", "verdict", "checks", "errors", "warnings"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "workUnitId": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "enum": ["READY", "BLOCKED"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "critical", "message"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
          "critical": { "type": "boolean" },
          "message": { "type": "string" }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gee-v1/repo-index.schema.json",
  "title": "GEE V1 R6 repository index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "indexKind", "engine", "policy", "entries", "indexSha256"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "indexKind": { "type": "string", "const": "GEE_REPO_INDEX" },
    "engine": { "type": "string", "const": "GEE_V1_REPO_INDEX_R6" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyVersion", "roots", "excludedDirectorySegments", "excludedPathPrefixes", "subsystemRules", "layerRules", "governancePrefixes", "geeRelevantPrefixes", "trackedStatusSource", "trackedPathsSha256"],
      "properties": {
        "policyVersion": { "type": "string", "minLength": 1 },
        "roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "excludedDirectorySegments": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "excludedPathPrefixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "subsystemRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prefix", "subsystem"],
            "properties": {
              "prefix": { "type": "string", "minLength": 1 },
              "subsystem": { "type": "string", "minLength": 1 }
            }
          }
        },
        "layerRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prefix", "layer"],
            "properties": {
              "prefix": { "type": "string", "minLength": 1 },
              "layer": { "type": "string", "minLength": 1 }
            }
          }
        },
        "governancePrefixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "geeRelevantPrefixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "trackedStatusSource": { "type": "string", "enum": ["UNAVAILABLE", "SUPPLIED"] },
        "trackedPathsSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "subsystem", "layer", "governanceArtifact", "geeRelevant", "tracked", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["JSON_SCHEMA", "JSON", "NDJSON", "ESM_MODULE", "SCRIPT", "MARKDOWN", "OTHER"] },
          "subsystem": { "type": ["string", "null"], "minLength": 1 },
          "layer": { "type": ["string", "null"], "minLength": 1 },
          "governanceArtifact": { "type": "boolean" },
          "geeRelevant": { "type": "boolean" },
          "tracked": { "type": "string", "enum": ["TRACKED", "UNTRACKED", "UNKNOWN"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "indexSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metrics": { "type": "object" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate-authorization-authority.schema.json",
  "title": "Gate authorization authority (legacy signed or local explicit)",
  "description": "The ONLY document that grants a Gate authorization. Signed with an ed25519 PROJECT_OWNER key whose private half never enters the governed set, so forgery requires the key rather than a text editor. It authorizes exactly one NOT_STARTED -> AUTHORIZED_NOT_STARTED ledger transition plus the Gate's first sealed R0001 state revision, over one exact artifact cohort identified by approvedBindingDigest. It can never authorize START, execution, closure or a second use: transitionType, fromStatus, toStatus and purpose are const, executionAuthorized is const false, and maxUse is const 1. NOTE ON ENFORCEMENT: this repository's canonical schema validator implements a draft-07 SUBSET and ignores $ref/definitions/allOf/contains/maxItems; those keywords are deliberately avoided here rather than creating false strictness. Signature verification, digest recomputation, cohort cardinality and exact path templates are enforced normatively in governance/gee-v1/core/gate-authorization-authority.mjs and permanently re-enforced in governance/tools/validate-status-ledger.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "documentKind", "authorityId", "issuedBy", "issuedAtUtc", "expiresAtUtc",
    "projectId", "gateId", "purpose", "transitionType", "fromStatus", "toStatus",
    "baseCommit", "preLedgerSha256", "previousEventSha256", "contractSha256",
    "currentContractSha256", "dependencyProof", "stateRevision",
    "authorizedStateArtifacts", "authorizedDerivedArtifacts",
    "bindingDigestAlgorithm", "approvedBindingDigest", "approvedRequestDigest",
    "executionAuthorized", "maxUse"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authorityMode": { "enum": ["LEGACY_SIGNED_AUTHORITY", "LOCAL_EXPLICIT_AUTHORITY"] },
    "documentKind": { "const": "ACTIVE_GATE_AUTHORIZATION_AUTHORITY" },
    "authorityId": { "type": "string", "minLength": 1 },
    "issuedBy": { "const": "PROJECT_OWNER" },
    "issuedAtUtc": { "type": "string", "minLength": 20 },
    "expiresAtUtc": { "type": "string", "minLength": 20 },
    "projectId": { "type": "string", "minLength": 1 },
    "gateId": { "type": "string", "minLength": 1 },
    "purpose": { "const": "GATE_NORMAL_AUTHORIZATION" },
    "transitionType": { "const": "AUTHORIZATION" },
    "fromStatus": { "const": "NOT_STARTED" },
    "toStatus": { "const": "AUTHORIZED_NOT_STARTED" },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "preLedgerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previousEventSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "currentContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependencyProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "status", "authorityPath", "authoritySha256"],
      "properties": {
        "gateId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["COMPLETE_CONFIRMED", "SUPERSEDED"] },
        "authorityPath": { "type": "string", "minLength": 1 },
        "authoritySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "stateRevision": { "const": "R0001" },
    "authorizedStateArtifacts": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cohortRole", "repoRelativePath", "sha256", "byteLength"],
        "properties": {
          "cohortRole": { "enum": ["CURRENT_STATE", "CHECKPOINT", "OPEN_DEFECTS", "STATE_SEAL"] },
          "repoRelativePath": { "type": "string", "pattern": "^governance/gates/[^/*?\\\\]+/state/[^*?\\\\]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "byteLength": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "authorizedDerivedArtifacts": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cohortRole", "repoRelativePath", "sha256", "byteLength"],
        "properties": {
          "cohortRole": { "enum": ["GATE_STATUS_SNAPSHOT", "ACTIVE_GATE", "ACTIVE_GATE_CONTEXT_JSON", "ACTIVE_GATE_CONTEXT_MD"] },
          "repoRelativePath": { "enum": ["governance/state/generated/GATE_STATUS_SNAPSHOT.json", "governance/active/ACTIVE_GATE.json", "governance/generated/ACTIVE_GATE_CONTEXT.json", "governance/generated/ACTIVE_GATE_CONTEXT.md"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "byteLength": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "bindingDigestAlgorithm": { "const": "SHA256_CANONICAL_JSON_GATE_AUTHORIZATION_BINDING_V1" },
    "approvedBindingDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvedRequestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionAuthorized": { "const": false },
    "maxUse": { "const": 1 },
    "ownerKeyId": { "type": "string", "minLength": 1 },
    "signatureAlgorithm": { "const": "ed25519" },
    "signature": { "type": "string", "minLength": 1 }
  }
}

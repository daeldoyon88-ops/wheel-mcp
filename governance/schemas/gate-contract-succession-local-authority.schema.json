{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate-contract-succession-local-authority.schema.json",
  "title": "GATE_CONTRACT_SUCCESSION_LOCAL_AUTHORITY",
  "description": "LOCAL_EXPLICIT_AUTHORITY form of the CURRENT_CONTRACT_SWITCH authority. Carries no key material: ownerKeyId, signatureAlgorithm, signature, privateKeyPath, externalSigner, ownerKeyHistory, recoveryRoot and keyRotation are all rejected by additionalProperties:false and by FORBIDDEN_SIGNATURE_FIELDS in gate-contract-succession-authority.mjs. Purpose and authorizedOperation are pinned, so this document can never authorize START, closure, a ledger append or an ACTIVE_GATE switch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentKind", "authorityMode", "authorityId", "issuedBy", "issuedAtUtc", "localRequestDigestAlgorithm", "approvedRequestDigest", "projectId", "gateId", "purpose", "reason", "predecessorContractPath", "predecessorContractSha256", "predecessorCurrentContractPath", "predecessorCurrentContractSha256", "successorContractPath", "successorContractSha256", "successorCurrentContractPath", "successorCurrentContractSha256", "previousContractPath", "previousContractSha256", "successorRevision", "authorizedDelta", "authorizedDeltaDigest", "currentGateStatus", "ledgerHeadEventId", "ledgerHeadEventPayloadSha256", "ledgerSha256", "baseCommit", "expiresAtUtc", "maxUse", "successorAuthorized", "authorizedOperation", "authorizedPaths", "stateRevision", "statePaths", "recordDigest", "bindingDigest", "pushAuthorized", "prohibitedOperations"],
  "properties": {
    "schemaVersion": { "const": 1 }, "documentKind": { "const": "GATE_CONTRACT_SUCCESSION_LOCAL_AUTHORITY" }, "authorityMode": { "const": "LOCAL_EXPLICIT_AUTHORITY" }, "authorityId": { "type": "string", "minLength": 1 }, "issuedBy": { "const": "PROJECT_OWNER" }, "issuedAtUtc": { "type": "string", "format": "date-time" },
    "localRequestDigestAlgorithm": { "const": "SHA256_CANONICAL_JSON_GATE_CONTRACT_SUCCESSION_LOCAL_REQUEST_V1" }, "approvedRequestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectId": { "type": "string", "minLength": 1 }, "gateId": { "type": "string", "pattern": "^GATE(1[4-9]|[23][0-9]|40)$" }, "purpose": { "const": "OWNER_AUTHORIZED_CONTRACT_SUCCESSION" }, "reason": { "type": "string", "minLength": 1 },
    "predecessorContractPath": { "type": "string", "minLength": 1 }, "predecessorContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "predecessorCurrentContractPath": { "type": "string", "minLength": 1 }, "predecessorCurrentContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "successorContractPath": { "type": "string", "minLength": 1 }, "successorContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "successorCurrentContractPath": { "type": "string", "minLength": 1 }, "successorCurrentContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "previousContractPath": { "type": "string", "minLength": 1 }, "previousContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "successorRevision": { "type": "string", "pattern": "^R[0-9]{4}$" },
    "authorizedDelta": { "type": "array", "minItems": 1 }, "authorizedDeltaDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "currentGateStatus": { "type": "string", "enum": ["NOT_STARTED", "AUTHORIZED_NOT_STARTED", "IN_PROGRESS", "REPAIR_REQUIRED", "BLOCKED_GOVERNANCE", "INTERRUPTED_RESUMABLE", "COMPLETE_AGENT", "COMPLETE_CONFIRMED", "SUPERSEDED", "REOPENED_AUTHORIZED"] }, "ledgerHeadEventId": { "type": "string", "minLength": 1 }, "ledgerHeadEventPayloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "ledgerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "expiresAtUtc": { "type": "string", "format": "date-time" }, "maxUse": { "const": 1 }, "successorAuthorized": { "const": true }, "authorizedOperation": { "const": "CURRENT_CONTRACT_SWITCH" },
    "authorizedPaths": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "stateRevision": { "type": "string", "pattern": "^R[0-9]{4}$" }, "statePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "recordDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bindingDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "pushAuthorized": { "const": false },
    "prohibitedOperations": { "type": "array", "uniqueItems": true, "minItems": 10, "items": { "type": "string", "enum": ["START", "AGENT_CLOSURE", "EXTERNAL_CONFIRMATION", "COMPLETE_AGENT", "COMPLETE_CONFIRMED", "ACTIVE_GATE_SWITCH", "GEE_R8", "GIT_PUSH", "HISTORY_REWRITE", "LEDGER_REWRITE"] } }
  }
}

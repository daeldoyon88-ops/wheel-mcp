{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate-start-authority-request.schema.json",
  "title": "Closed GATE_START_AUTHORITY request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentKind", "requestId", "projectId", "gateId", "purpose", "eventId", "transitionType", "fromStatus", "toStatus", "recordedAt", "baseCommit", "preStartLedgerSha256", "previousEventSha256", "contractSha256", "currentContractSha256", "preStateRevision", "preCurrentStateSha256", "preStateSealSha256", "readinessDigest", "dependencyProof", "activeGatePreState", "authorizedStartWritePaths", "functionalExecutionScope", "expiresAtUtc", "maxUse", "prohibitedOperations", "startAuthorized", "executionAuthorized", "bindingDigestAlgorithm", "bindingDigest", "requestDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authorityMode": { "enum": ["LEGACY_SIGNED_AUTHORITY", "LOCAL_EXPLICIT_AUTHORITY"] },
    "documentKind": { "const": "GATE_START_AUTHORITY_REQUEST" },
    "requestId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "gateId": { "type": "string", "pattern": "^GATE(1[4-9]|[23][0-9]|40)$" },
    "purpose": { "const": "START_PLUS_EXECUTION_AUTHORITY" },
    "eventId": { "type": "string", "minLength": 1 },
    "transitionType": { "const": "START" },
    "fromStatus": { "const": "AUTHORIZED_NOT_STARTED" },
    "toStatus": { "const": "IN_PROGRESS" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "preStartLedgerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previousEventSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "currentContractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preStateRevision": { "const": "R0001" },
    "preCurrentStateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preStateSealSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "readinessDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependencyProof": { "type": "object", "additionalProperties": false, "required": ["gateId", "status", "authorityPath", "authoritySha256"], "properties": { "gateId": { "type": "string", "minLength": 1 }, "status": { "enum": ["COMPLETE_AGENT", "COMPLETE_CONFIRMED"] }, "authorityPath": { "type": "string", "minLength": 1 }, "authoritySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "activeGatePreState": { "type": "object", "additionalProperties": false, "required": ["activeGate", "sha256", "byteLength"], "properties": { "activeGate": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "byteLength": { "type": "integer", "minimum": 0 } } },
    "authorizedStartWritePaths": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/*?]+(?:/[^\\\\/*?]+)*$" } },
    "functionalExecutionScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/*?]+(?:/[^\\\\/*?]+)*$" } },
    "ownerKeyId": { "type": "string", "minLength": 1 },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "maxUse": { "const": 1 },
    "prohibitedOperations": { "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": { "enum": ["AUTHORIZATION", "SECOND_START", "AGENT_CLOSURE", "EXTERNAL_CONFIRMATION", "COMPLETE_CONFIRMED", "OTHER_GATE", "GEE_REVISION_CREATION", "ARBITRARY_LEDGER_TRANSITION", "LEDGER_REWRITE", "ARBITRARY_GOVERNANCE_WRITE", "GIT_PUSH"] } },
    "startAuthorized": { "const": true },
    "executionAuthorized": { "const": true },
    "bindingDigestAlgorithm": { "const": "SHA256_CANONICAL_JSON_GATE_START_BINDING_V1" },
    "bindingDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate-status-event.schema.json",
  "title": "Canonical gate status event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ordinal",
    "eventId",
    "gateId",
    "fromStatus",
    "toStatus",
    "transitionType",
    "authorityPath",
    "authoritySha256",
    "previousEventSha256",
    "recordedAt",
    "eventPayloadSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "gateId": {
      "type": "string",
      "pattern": "^GATE(0[0-9]|[1-3][0-9]|40)$"
    },
    "fromStatus": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "NOT_STARTED",
            "AUTHORIZED_NOT_STARTED",
            "IN_PROGRESS",
            "REPAIR_REQUIRED",
            "BLOCKED_GOVERNANCE",
            "INTERRUPTED_RESUMABLE",
            "COMPLETE_AGENT",
            "COMPLETE_CONFIRMED",
            "SUPERSEDED",
            "REOPENED_AUTHORIZED"
          ]
        }
      ]
    },
    "toStatus": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "AUTHORIZED_NOT_STARTED",
        "IN_PROGRESS",
        "REPAIR_REQUIRED",
        "BLOCKED_GOVERNANCE",
        "INTERRUPTED_RESUMABLE",
        "COMPLETE_AGENT",
        "COMPLETE_CONFIRMED",
        "SUPERSEDED",
        "REOPENED_AUTHORIZED"
      ]
    },
    "transitionType": {
      "type": "string",
      "enum": [
        "GENESIS_IMPORT",
        "AUTHORIZATION",
        "START",
        "INTERRUPTION",
        "RESUME",
        "DEFECT_OPENED",
        "REPAIR_ACCEPTED",
        "GOVERNANCE_BLOCK",
        "GOVERNANCE_UNBLOCK",
        "AGENT_CLOSURE",
        "EXTERNAL_CONFIRMATION",
        "EXTERNAL_REJECTION",
        "AUTHORIZED_REOPEN",
        "RESUME_AFTER_REOPEN",
        "SUPERSESSION",
        "HISTORICAL_RECONCILIATION",
        "CONTRACT_SUCCESSION",
        "PRECONTRACT_CONSUMPTION_ANCHOR"
      ],
      "description": "The first fifteen values are NORMAL_EXECUTION_TRANSITION types, governed by the closed I2 transition table. HISTORICAL_RECONCILIATION is a distinct, strictly narrower transition class: it corrects a documented UNRESOLVED_STATUS_FALLBACK genesis status from recovered historical authority without implying authorization, start, execution or completion. Its authorityPath/authoritySha256 must pin a historical-reconciliation.schema.json record, which in turn binds the superseded genesis event, the fallback basis, a PROJECT_OWNER authorization and a byte-verified evidence cohort. The two classes never share a transition table; see governance/tools/validate-status-ledger.mjs."
    },
    "authorityPath": {
      "type": "string",
      "minLength": 1
    },
    "authoritySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previousEventSha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "eventPayloadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stateRevision": {
      "type": "string",
      "pattern": "^R[0-9]{4}$"
    },
    "stateRevisionSealSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "precontractConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "description": "Present only on a PRECONTRACT_CONSUMPTION_ANCHOR event. It states, in the append-only spine, the exact bytes of one precontract consumption receipt, so that a later rewrite of that receipt is detectable from history rather than from the receipt's own self-description. See validatePrecontractConsumptionAnchor in governance/tools/validate-status-ledger.mjs.",
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/*?]+(?:/[^\\\\/*?]+)*$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

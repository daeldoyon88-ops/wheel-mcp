{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "governance-transaction.schema.json",
  "title": "Atomic governance transaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "transactionState", "caseType", "gateId", "stagedArtifacts", "expectedHashes", "oldPointers", "newPointers", "commitOrder", "rollbackPlan", "recoveryPlan", "idempotencyKeys"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "transactionId": { "type": "string", "pattern": "^TXN_[A-Za-z0-9_-]+$" },
    "transactionState": { "type": "string", "enum": ["PREPARING", "PREPARED", "COMMITTING", "COMMITTED", "ABORTED", "RECOVERY_REQUIRED"] },
    "caseType": { "type": "string", "enum": ["INTERNAL_REVISION", "STATUS_TRANSITION"] },
    "gateId": { "type": "string", "pattern": "^GATE(0[0-9]|[1-3][0-9]|40)$" },
    "stagedArtifacts": { "type": "array" },
    "expectedHashes": { "type": "array" },
    "oldPointers": { "type": "array" },
    "newPointers": { "type": "array" },
    "ledgerEvent": { "type": ["object", "null"] },
    "commitOrder": { "type": "array", "minItems": 1 },
    "rollbackPlan": { "type": "array" },
    "recoveryPlan": { "type": "array" },
    "idempotencyKeys": { "type": "object" },
    "preparedAt": { "type": ["string", "null"], "format": "date-time" },
    "committedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "caseType": { "const": "STATUS_TRANSITION" } } },
      "then": { "required": ["ledgerEvent"], "properties": { "ledgerEvent": { "type": "object" } } }
    },
    {
      "if": { "properties": { "caseType": { "const": "INTERNAL_REVISION" } } },
      "then": { "properties": { "ledgerEvent": { "type": "null" } } }
    }
  ]
}

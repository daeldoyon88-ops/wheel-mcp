{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "precontract-authority-consumption.schema.json",
  "title": "Single-use receipt for a local explicit precontract authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentKind", "schemaVersion", "authorityId", "authorityMode", "projectId", "gateId", "approvedRequestDigest", "baseCommit", "baseTree", "consumedUse", "recordedAt", "cohort", "consumptionIdentityAlgorithm", "consumptionIdentityDigest"],
  "properties": {
    "documentKind": { "const": "PRECONTRACT_AUTHORITY_CONSUMPTION" },
    "schemaVersion": { "const": 1 },
    "authorityId": { "type": "string", "minLength": 1 },
    "authorityMode": { "const": "LOCAL_EXPLICIT_AUTHORITY" },
    "projectId": { "type": "string", "minLength": 1 },
    "gateId": { "type": "string", "pattern": "^GATE(0[0-9]|[1-3][0-9]|40)$" },
    "approvedRequestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "baseTree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "consumedUse": { "const": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "cohort": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/*?]+(?:/[^\\\\/*?]+)*$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "consumptionIdentityAlgorithm": { "const": "SHA256_CANONICAL_JSON_PRECONTRACT_CONSUMPTION_IDENTITY_V1" },
    "consumptionIdentityDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

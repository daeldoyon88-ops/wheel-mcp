{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "precontract-authority-request.schema.json",
  "title": "Unsigned precontract authority request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentKind", "requestId", "projectId", "gateId", "purpose", "operation", "baseCommit", "ledgerSha256", "currentStatus", "dependencyProof", "authorizedPaths", "artifactBindings", "expiresAtUtc", "maxUse", "prohibitedOperations", "requestDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentKind": { "const": "PRECONTRACT_AUTHORITY_REQUEST" },
    "requestId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "gateId": { "type": "string", "pattern": "^GATE(0[0-9]|[1-3][0-9]|40)$" },
    "purpose": { "const": "BOOTSTRAP_CONTRACT_CANONICALIZATION" },
    "operation": { "const": "BOOTSTRAP_CONTRACT_CANONICALIZATION" },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "ledgerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "currentStatus": { "const": "NOT_STARTED" },
    "dependencyProof": {
      "type": "object", "additionalProperties": false,
      "required": ["gateId", "status", "authorityPath", "authoritySha256"],
      "properties": {
        "gateId": { "type": "string", "pattern": "^GATE(0[0-9]|[1-3][0-9]|40)$" },
        "status": { "enum": ["COMPLETE_AGENT", "COMPLETE_CONFIRMED"] },
        "authorityPath": { "type": "string", "minLength": 1 },
        "authoritySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "authorizedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "artifactBindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "maxUse": { "const": 1 },
    "prohibitedOperations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "precontract-authority.schema.json",
  "title": "Owner-signed active precontract authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentKind", "authorityId", "issuedBy", "issuedAtUtc", "approvedRequestDigest", "projectId", "gateId", "purpose", "operation", "authorizedPaths", "artifactBindings", "expiresAtUtc", "maxUse", "ownerKeyId", "signatureAlgorithm", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentKind": { "const": "ACTIVE_PRECONTRACT_AUTHORITY" },
    "authorityId": { "type": "string", "minLength": 1 },
    "issuedBy": { "const": "PROJECT_OWNER" },
    "issuedAtUtc": { "type": "string", "format": "date-time" },
    "approvedRequestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "gateId": { "type": "string", "pattern": "^GATE(0[0-9]|[1-3][0-9]|40)$" },
    "purpose": { "const": "BOOTSTRAP_CONTRACT_CANONICALIZATION" },
    "operation": { "const": "BOOTSTRAP_CONTRACT_CANONICALIZATION" },
    "authorizedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "artifactBindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "maxUse": { "const": 1 },
    "ownerKeyId": { "type": "string", "minLength": 1 },
    "signatureAlgorithm": { "const": "ed25519" },
    "signature": { "type": "string", "minLength": 1 }
  }
}

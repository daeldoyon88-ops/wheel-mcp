{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "precontract-consumption-anchor-authority.schema.json",
  "title": "Single-use local authority to anchor a precontract consumption receipt in the append-only ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentKind", "schemaVersion", "authorityId", "authorityMode", "issuedBy", "issuedAtUtc", "projectId", "gateId", "precontractAuthorityPath", "precontractAuthorityId", "consumptionRecordPath", "consumptionRecordSha256", "maxUse", "prohibitedOperations"],
  "properties": {
    "documentKind": { "const": "GATE_PRECONTRACT_CONSUMPTION_ANCHOR_LOCAL_AUTHORITY" },
    "schemaVersion": { "const": 1 },
    "authorityId": { "type": "string", "minLength": 1 },
    "authorityMode": { "const": "LOCAL_EXPLICIT_AUTHORITY" },
    "issuedBy": { "const": "PROJECT_OWNER" },
    "issuedAtUtc": { "type": "string", "format": "date-time" },
    "projectId": { "type": "string", "minLength": 1 },
    "gateId": { "type": "string", "pattern": "^GATE(0[0-9]|[1-3][0-9]|40)$" },
    "precontractAuthorityPath": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/*?]+(?:/[^\\\\/*?]+)*$" },
    "precontractAuthorityId": { "type": "string", "minLength": 1 },
    "consumptionRecordPath": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/*?]+(?:/[^\\\\/*?]+)*$" },
    "consumptionRecordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "maxUse": { "const": 1 },
    "reason": { "type": "string" },
    "prohibitedOperations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
